# ==============================================================================
# ResourceShift AI - Environment Variables Template
# Copy this file to .env and populate with your local values.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# --- AI & Reasoning Engine ---
# Google Gemini API key (Required for reasoning & anomaly investigation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Backend Application (FastAPI) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Building Configuration (Single College Building Target) ---
BUILDING_ID=ENG_HALL_01
BUILDING_NAME="Engineering Hall - North Wing"
AFTER_HOURS_START=19:00
AFTER_HOURS_END=06:00
ELECTRICITY_RATE_PER_KWH=0.14
CO2_KG_PER_KWH=0.42

# --- Google Cloud & Firebase (Planned / Optional for local mock) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_EMULATOR_HOST=
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# --- Model Context Protocol (MCP) Server ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
